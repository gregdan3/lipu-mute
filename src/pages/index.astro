---
import Layout from "@layouts/Layout.astro";
import Chart from "@components/chart/Chart.astro";
import ChartController from "@components/chart/ChartController.astro";

import Toast from "@components/Toast.astro";

const frontmatter = { title: "ilo Muni" };
---

<script>
  import type {
    Scale,
    Smoother,
    Query,
    Field,
    Params,
    UnitTime,
  } from "@utils/types";
  import { hasError } from "@utils/input.ts";
  import { UsageChart, UsageChartElem } from "@utils/chart.ts";
  import { toURLParams } from "@utils/urlparams.ts";
  import { truncateLabel } from "@utils/other.ts";
  import { fetchElems } from "@utils/ui.ts";
  import { countQuery } from "@utils/analytics.ts";

  const els = {
    usageCanvas: ["usage", HTMLCanvasElement],
    searchBox: ["searchBox", HTMLInputElement],

    scaleDropdown: ["scaleDropdown", HTMLSelectElement],
    unitDropdown: ["unitDropdown", HTMLSelectElement],
    fieldDropdown: ["fieldDropdown", HTMLSelectElement],
    smootherDropdown: ["smootherDropdown", HTMLSelectElement],
    smoothingDropdown: ["smoothingDropdown", HTMLSelectElement],

    startDropdown: ["startDropdown", HTMLSelectElement],
    endDropdown: ["endDropdown", HTMLSelectElement],

    loader: ["usageLoader", HTMLSpanElement],
    errorer: ["usageErrorer", HTMLSpanElement],
    errorBin: ["errorBin", HTMLDivElement],

    usageForm: ["usageForm", HTMLFormElement],
  } as const;

  const $ = fetchElems(els);

  function dumpErrors(queries: Query[]) {
    $.errorBin.innerHTML = "";
    $.errorBin.textContent = "";

    for (const q of queries) {
      const hasErrors =
        q.errors.length > 0 || q.terms.some((t) => t.errors.length > 0);
      if (!hasErrors) continue;

      // for query
      const ul = document.createElement("ul");

      // query's label
      const headerLi = document.createElement("li");
      headerLi.textContent = truncateLabel(q.raw ?? q.repr) + ":";
      ul.appendChild(headerLi);

      // error container
      const childUl = document.createElement("ul");

      // query-level errs
      for (const err of q.errors) {
        const li = document.createElement("li");
        li.textContent = `${err.message}`;
        childUl.appendChild(li);
      }

      // term-level errors
      for (const t of q.terms) {
        for (const err of t.errors) {
          const li = document.createElement("li");
          const label = truncateLabel(t.raw ?? t.repr);
          li.textContent = `${label}: ${err.message}`;
          childUl.appendChild(li);
        }
      }

      ul.appendChild(childUl);
      $.errorBin.appendChild(ul);
    }
  }

  async function updatePage(chart: UsageChart, params: Params) {
    $.loader.style.visibility = "visible";
    $.errorer.style.visibility = "hidden";

    let queries: Query[] = [];
    try {
      queries = await chart.update(params);
      dumpErrors(queries);
    } catch (err) {
      console.error("Couldn't update chart!", err);

      $.errorBin.innerHTML = "";
      $.errorBin.textContent = `Something went wrong! ${err}`;
      $.errorer.style.visibility = "visible";
    } finally {
      $.loader.style.visibility = "hidden";
    }

    const graphable = queries.filter((q) => !hasError(q));
    const query = graphable.map((q) => q.repr).join(", ");

    // some params get changed by the query itself
    let usedParams: Params = {
      query,
      scale: $.scaleDropdown.value as Scale,
      field: $.fieldDropdown.value as Field,
      smoother: $.smootherDropdown.value as Smoother,
      smoothing: Number($.smoothingDropdown.value),
      start: Number($.startDropdown.value),
      end: Number($.endDropdown.value),
      unit: $.unitDropdown.value as UnitTime,
    };

    if (graphable.length > 0) {
      toURLParams(usedParams);
      countQuery();
    }
  }

  document.addEventListener("DOMContentLoaded", async () => {
    const elem = document.querySelector("usage-chart") as UsageChartElem;
    const chart = elem!.chart!;
    document.addEventListener("chart-controller-updated", async (e: Event) => {
      const event = e as CustomEvent<Params>;
      await updatePage(chart, event.detail);
    });
  });
</script>

<Layout frontmatter={frontmatter}>
  <ChartController chartId="usage" controllerId="usageForm" />
  <Chart large={true} chartId="usage" controllerId="usageForm" />

  <div id="errorBin"></div>

  <Toast />
</Layout>

<style>
  #errorBin {
    font-size: 0.9em;
    line-height: 1.5em;
  }
  #errorBin * {
    padding: 0;
    margin: 0;
  }
</style>
