---
import type { Params } from "@utils/types";
import Loader from "@components/Loader.astro";
import Errorer from "@components/Errorer.astro";
import { defaults } from "@utils/constants";

export interface ChartConfig {
  chartId: string;
  controllerId?: string;
  params?: Partial<Params>;
}

const {
  chartId,
  controllerId,
  params: localParams = {},
} = Astro.props as ChartConfig;

let params = {};
if (localParams.query) {
  params = { ...defaults, ...localParams };
}
---

<usage-chart
  data-chart-id={chartId}
  data-controller-id={controllerId}
  data-params={JSON.stringify(params)}
  style="position: relative; margin-top: 0.25em;"
>
  <canvas id={chartId} style="width: 100%;  max-height: 70vh;"></canvas>
  <div id=`${chartId}Legend` style="margin-top: 0.75em;">
    <div
      style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); pointer-events: none;"
    >
      <Loader id=`${chartId}Loader` />
      <Errorer id=`${chartId}Errorer` />
    </div>
  </div>
</usage-chart>

<style></style>

<script>
  import { UsageChartElem } from "@utils/chart";

  customElements.define("usage-chart", UsageChartElem);
</script>
