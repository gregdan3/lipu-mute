---
import type { Params } from "@utils/types";
import Loader from "@components/Loader.astro";
import Errorer from "@components/Errorer.astro";
import { defaults } from "@utils/constants";

export interface ChartConfig {
  chartId: string;
  controllerId?: string;
  params?: Partial<Params>;
  large?: boolean;
}

const {
  chartId,
  controllerId,
  params: localParams = {},
  large = false,
} = Astro.props as ChartConfig;

let params = {};
if (localParams.query) {
  params = { ...(defaults as Params), ...localParams };
}
---

<usage-chart
  data-chart-id={chartId}
  data-controller-id={controllerId}
  data-params={JSON.stringify(params)}
  class={large ? "chart chart-large" : "chart chart-small"}
>
  <div class="chart-container">
    <canvas id={chartId}></canvas>

    <div class="chart-overlay">
      <Loader id={`${chartId}Loader`} />
      <Errorer id={`${chartId}Errorer`} />
    </div>
  </div>

  <div id={`${chartId}Legend`} style="margin-top: 0.75em;"></div>
</usage-chart>

<style>
  .chart {
    margin: 0.75em auto;
  }

  .chart-container {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }

  canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  .chart-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .chart-small .chart-container {
    max-height: 400px;
    aspect-ratio: 21 / 9;
  }

  .chart-large .chart-container {
    aspect-ratio: 2 / 1;
    max-height: 60vh;
  }
</style>

<script>
  import { UsageChartElem } from "@utils/chart";

  customElements.define("usage-chart", UsageChartElem);
</script>
