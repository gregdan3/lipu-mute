---
import IconButton from "@components/IconButton.astro";
---

<span data-download-image-button>
  <IconButton icon="mingcute:download-2-line" />
</span>

<script>
  import { downloadGraphImage } from "@utils/ui";
  const el = document.querySelector("[data-download-image-button]");
  if (el) {
    el.addEventListener("click", async () => {
      await downloadGraphImage();
      document.dispatchEvent(
        new CustomEvent("show-toast", {
          detail: { message: "Downloaded graph image" },
        }),
      );
    });
  }
</script>
